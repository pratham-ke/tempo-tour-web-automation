# Copy this file to .env.local and fill in real values.
# Never commit .env, .env.local, or credentials.
# Never commit auth/**/*.json storageState files.

# ---------------------------------------------------------------------------
# Runtime selection (used by config/resolveAppContext + Playwright projects)
# ---------------------------------------------------------------------------
# local | staging
TEST_ENV=local

# kedemo | ketest
TEST_TENANT=kedemo
DEFAULT_TENANT=kedemo

# Initial auth-supported roles: super-admin | admin | band
# Also configured (not yet in auth setup): crew | travel-agent | driver
TEST_ROLE=super-admin

# ---------------------------------------------------------------------------
# Credentials for INITIAL auth setup (Super Admin, Admin, Band)
# Pattern: {TENANT}_{ROLE}_USERNAME / {TENANT}_{ROLE}_PASSWORD
# Staging uses the same variable names; switch via TEST_ENV only.
# ---------------------------------------------------------------------------

# kedemo
KEDEMO_SUPER_ADMIN_USERNAME=
KEDEMO_SUPER_ADMIN_PASSWORD=
KEDEMO_ADMIN_USERNAME=
KEDEMO_ADMIN_PASSWORD=
KEDEMO_BAND_USERNAME=
KEDEMO_BAND_PASSWORD=

# ketest
KETEST_SUPER_ADMIN_USERNAME=
KETEST_SUPER_ADMIN_PASSWORD=
KETEST_ADMIN_USERNAME=
KETEST_ADMIN_PASSWORD=
KETEST_BAND_USERNAME=
KETEST_BAND_PASSWORD=

# ---------------------------------------------------------------------------
# Optional later roles (configured in config/roles.ts; not used by auth setup yet)
# ---------------------------------------------------------------------------
# KEDEMO_CREW_USERNAME=
# KEDEMO_CREW_PASSWORD=
# KEDEMO_TRAVEL_AGENT_USERNAME=
# KEDEMO_TRAVEL_AGENT_PASSWORD=
# KEDEMO_DRIVER_USERNAME=
# KEDEMO_DRIVER_PASSWORD=
# KETEST_CREW_USERNAME=
# KETEST_CREW_PASSWORD=
# KETEST_TRAVEL_AGENT_USERNAME=
# KETEST_TRAVEL_AGENT_PASSWORD=
# KETEST_DRIVER_USERNAME=
# KETEST_DRIVER_PASSWORD=
