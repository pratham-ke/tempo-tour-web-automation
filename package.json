{
  "name": "tempo-tour-web-automation",
  "version": "1.0.0",
  "description": "Playwright + TypeScript E2E automation framework for Tempo Tour web application",
  "private": true,
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "auth:setup": "playwright test --project=auth-setup",
    "report": "playwright show-report",
    "codegen": "playwright codegen"
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "automation",
    "tempo-tour"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
